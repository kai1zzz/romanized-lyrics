{
	"name": "@kai1zzz/luna-plugins",
	"description": "Plugins de kai1zzz para TidaLuna: letras romanizadas (romaji, coreano, pinyin)",
	"type": "module",
	"scripts": {
		"watch": "concurrently \"pnpm:build --watch\" pnpm:serve",
		"build": "rimraf ./dist && tsx esbuild.config.ts",
		"serve": "http-server ./dist -p 3000 -s --cors -c-1",
		"test": "tsx plugins/RomajiLyrics/test/romanize.test.ts",
		"typecheck": "tsc --noEmit -p ."
	},
	"devDependencies": {
		"@types/node": "^25.0.9",
		"@types/react": "^19.2.8",
		"@types/react-dom": "^19.2.3",
		"concurrently": "^9.2.1",
		"electron": "^40.0.0",
		"http-server": "^14.1.1",
		"luna": "github:Inrixia/TidaLuna",
		"oby": "^15.1.2",
		"rimraf": "^6.1.2",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
	}
}